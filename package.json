{
	"name": "shopify-cloudflare-hono-preact-iso-starter",
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#/*": [
			"./src/*"
		]
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"test": "vp test",
		"deploy": "vp build && wrangler deploy",
		"codegen": "graphql-codegen --project=admin",
		"typegen": "wrangler types cloudflare.d.ts",
		"shopify:build": "shopify app build",
		"shopify:dev": "shopify app dev"
	},
	"dependencies": {
		"@shopify/shopify-api": "13.0.0",
		"hono": "4.12.26",
		"preact": "10.29.2",
		"preact-iso": "2.12.0",
		"preact-render-to-string": "6.7.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.41.0",
		"@cloudflare/vitest-pool-workers": "0.16.16",
		"@preact/preset-vite": "2.10.5",
		"@shopify/api-codegen-preset": "2.0.0",
		"@shopify/app-bridge-types": "0.7.1",
		"@shopify/app-bridge-ui-types": "0.3.3",
		"@shopify/polaris-types": "1.0.7",
		"@testing-library/preact": "3.2.4",
		"@vitest/browser-playwright": "4.1.9",
		"playwright": "1.61.0",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.1",
		"vite-plus": "0.2.1",
		"vitest": "4.1.9",
		"wrangler": "4.101.0"
	},
	"optionalDependencies": {
		"@shopify/cli": "4.2.0"
	},
	"overrides": {
		"vite": "$vite"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "npm@11.12.1"
}
