{
	"name": "shopify-cloudflare-hono-preact-iso-starter",
	"version": "1.0.0",
	"type": "module",
	"imports": {
		"#/*": [
			"./src/*"
		]
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"test": "vp test",
		"deploy": "vp build && wrangler deploy",
		"codegen": "graphql-codegen --project=admin",
		"typegen": "wrangler types cloudflare.d.ts",
		"shopify:build": "shopify app build",
		"shopify:dev": "shopify app dev"
	},
	"dependencies": {
		"@effect/platform-browser": "4.1.2",
		"@shopify/shopify-api": "14.0.0",
		"effect": "4.1.2",
		"foldkit": "0.170.0",
		"preact": "11.1.1",
		"preact-iso": "2.12.2",
		"preact-render-to-string": "6.8.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.51.2",
		"@cloudflare/vitest-pool-workers": "0.21.0",
		"@preact/preset-vite": "2.10.6",
		"@shopify/api-codegen-preset": "3.0.0",
		"@shopify/app-bridge-types": "0.7.2",
		"@shopify/app-bridge-ui-types": "0.3.3",
		"@shopify/polaris-types": "1.0.7",
		"@testing-library/preact": "3.2.4",
		"@vitest/browser-playwright": "4.1.10",
		"playwright": "1.62.1",
		"typescript": "7.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
		"vite-plus": "0.2.8",
		"vitest": "4.1.10",
		"wrangler": "4.120.1"
	},
	"optionalDependencies": {
		"@shopify/cli": "4.6.1"
	},
	"overrides": {
		"vite": "$vite"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"packageManager": "npm@12.0.2"
}
